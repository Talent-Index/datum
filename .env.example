# Chain. Fuji by default; point RPC_URL at Anvil for local development.
# Contract addresses are not configured here: each project row in Postgres
# carries its own escrow, settlement token and developer payout address,
# written when the project is created from the register page.
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# The platform registry: accounts, identity verdicts, listings and the hash
# of every activity. Deployed once with contracts/script/DeployRegistry.s.sol
# from PLATFORM_KEY, which becomes its owner.
REGISTRY_ADDRESS=

# Three separate keys so two-of-three is real rather than one account
# signing twice. PLATFORM_KEY is also the M-Pesa settlement wallet.
PLATFORM_KEY=
ORACLE_KEY=
SURVEYOR_KEY=

# Managed buyer accounts are derived from this seed. Rotating it orphans
# every existing buyer address; treat it like a custody key.
BUYER_MASTER_SEED=

# Sessions. People sign in with an email code and get a signed cookie.
# Operators unlock the register with the shared secret, as a bearer token
# or a cookie. SESSION_SECRET is at least 32 characters and rotating it
# signs everyone out; OPERATOR_SECRET at least 16.
SESSION_SECRET=
OPERATOR_SECRET=

# Sign-in codes are email only. Resend sends them when both of these are set.
# Production fails closed if either is missing: no code is logged, none is
# returned by the API, and sign-in responds 503. Local delivery to the server
# log requires NODE_ENV other than production AND EMAIL_OTP_DEV_LOG=1.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_OTP_DEV_LOG=

# Ignored in production. Outside production it is accepted only when
# EMAIL_OTP_DEV_LOG=1 and RESEND_API_KEY is unset. Leave it unset.
OTP_TEST_CODE=

# Africa's Talking is not used for sign-in. These remain for a future SMS
# notice and are not required to email a code.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Google is not offered on the sign-in screen. The Auth.js route remains
# for a later link and does not copy an M-Pesa number into the session.
# AUTH_SECRET can match SESSION_SECRET. Redirect URI, if used later:
# {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Share of an owner's budget taken as the initialisation deposit on a
# build request, before any agreement is signed. Never below KES 1,000.
BUILD_INITIAL_DEPOSIT_PERCENT=10

# The one-off fee, in whole shillings, that sellers, developers, companies
# and senders pay by M-Pesa before they can post or commit.
LISTING_FEE_KES=200

# Vercel sets this for its cron and sends it as a bearer token to
# /api/ops/replay, which finishes any paid instalment the callback could not.
CRON_SECRET=

# Postgres
DATABASE_URL=

# Cache for public data sources. Set for Vercel; omit locally to use the
# committed filesystem fixtures.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public data fetching. DATA_OFFLINE=1 replays the cache and never touches
# the network; set 0 plus a contact address to fetch live.
DATA_OFFLINE=1
DATA_CONTACT=

# Stage classification: "vlm" calls the vision-language model (needs
# ANTHROPIC_API_KEY), "sidecar" reads label files uploaded with the images.
STAGE_CLASSIFIER=vlm
ANTHROPIC_API_KEY=

# Safaricom Daraja (sandbox credentials from developer.safaricom.co.ke)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
